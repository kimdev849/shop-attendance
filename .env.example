# ---------------------------------------------------------------------------
# ShopAttendance - variables d'environnement (exemple)
# Copiez ce fichier en `.env` (racine) et en `apps/api/.env` puis renseignez
# de vraies valeurs. Ne jamais committer de vrais secrets.
# ---------------------------------------------------------------------------

# --- Base de données -------------------------------------------------------
POSTGRES_USER=shopattendance
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=shopattendance
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shopattendance:changeme_dev_password@localhost:5432/shopattendance?schema=public

# --- API ---------------------------------------------------------------
API_PORT=3001
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3000

# JWT
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_too_to_a_different_long_random_string
JWT_REFRESH_EXPIRES_IN=7d

# --- Dashboard (Next.js) ----------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3001

# --- Tablet app (Expo) --------------------------------------------------
EXPO_PUBLIC_API_URL=http://localhost:3001

# --- pgAdmin (optionnel, via docker-compose) ---------------------------
PGADMIN_DEFAULT_EMAIL=admin@shopattendance.local
PGADMIN_DEFAULT_PASSWORD=changeme_dev_password
PGADMIN_PORT=5050
