// ShopAttendance - schéma Prisma
// PostgreSQL - voir README section "Base de données" pour le détail des choix.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SHOP_MANAGER
  WORKER
}

enum WorkerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum ShopStatus {
  ACTIVE
  INACTIVE
}

enum DeviceStatus {
  ONLINE
  OFFLINE
  INACTIVE
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum AttendanceStatus {
  ON_TIME
  LATE
  ABSENT
}

enum SyncStatus {
  SYNCED
  PENDING
  FAILED
}

enum PenaltyStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum AbsenceStatus {
  PENDING
  VALIDATED
  REJECTED
}

// ---------------------------------------------------------------------------
// MODELS
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         UserRole @default(WORKER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  worker         Worker?
  managedShops   Shop[]        @relation("ShopManager")
  auditLogs      AuditLog[]
  approvedPenalties Penalty[]  @relation("PenaltyApprovedBy")
  validatedAbsences Absence[]  @relation("AbsenceValidatedBy")
  refreshTokens  RefreshToken[]

  @@index([role])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("refresh_tokens")
}

model Shop {
  id        String     @id @default(uuid())
  name      String
  code      String     @unique
  address   String?
  city      String?
  managerId String?
  manager   User?      @relation("ShopManager", fields: [managerId], references: [id])
  status    ShopStatus @default(ACTIVE)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  workers     Worker[]
  devices     Device[]
  schedules   Schedule[]
  attendances Attendance[]
  absences    Absence[]

  @@index([status])
  @@map("shops")
}

model Worker {
  id             String       @id @default(uuid())
  employeeNumber String       @unique
  firstName      String
  lastName       String
  phone          String?
  email          String?
  position       String?
  pinHash        String?      // Code PIN hashé (bcrypt) pour vérification au pointage
  pinSetAt       DateTime?    // Date de définition/changement du PIN
  facePhoto      String?      // Photo du visage en base64 pour reconnaissance faciale
  facePhotoSetAt DateTime?
  faceDescriptor String?      // Descripteur facial (JSON array 128 floats) pour face-api.js
  status         WorkerStatus @default(ACTIVE)
  shopId         String?
  shop           Shop?        @relation(fields: [shopId], references: [id])
  userId         String?      @unique
  user           User?        @relation(fields: [userId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  schedules   Schedule[]
  attendances Attendance[]
  absences    Absence[]
  penalties   Penalty[]

  @@index([shopId])
  @@index([status])
  @@map("workers")
}

model Device {
  id               String       @id @default(uuid())
  deviceIdentifier String       @unique
  name             String
  shopId           String
  shop             Shop         @relation(fields: [shopId], references: [id])
  lastSyncAt       DateTime?
  lastHeartbeatAt  DateTime?    // Dernier ping reçu de la tablette
  appVersion       String?
  status           DeviceStatus @default(OFFLINE)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  attendances Attendance[]

  @@index([shopId])
  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("devices")
}

model Schedule {
  id                String    @id @default(uuid())
  workerId          String
  worker            Worker    @relation(fields: [workerId], references: [id], onDelete: Cascade)
  shopId            String
  shop              Shop      @relation(fields: [shopId], references: [id])
  dayOfWeek         DayOfWeek
  startTime         String    // format "HH:mm", évalué dans le fuseau horaire du shop
  endTime           String    // format "HH:mm"
  toleranceMinutes  Int       @default(10)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([workerId, dayOfWeek])
  @@index([shopId])
  @@map("schedules")
}

model Attendance {
  id                String           @id @default(uuid())
  workerId          String
  worker            Worker           @relation(fields: [workerId], references: [id])
  shopId            String
  shop              Shop             @relation(fields: [shopId], references: [id])
  deviceId          String?
  device            Device?          @relation(fields: [deviceId], references: [id])
  attendanceDate    DateTime         @db.Date
  scheduledTime     DateTime?
  checkInTime       DateTime
  latenessMinutes   Int              @default(0)
  status            AttendanceStatus @default(ON_TIME)
  syncStatus        SyncStatus       @default(SYNCED)
  clientRequestId   String?          @unique // idempotency key from the tablet, prevents duplicates
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  penalty Penalty?

  @@unique([workerId, attendanceDate])
  @@index([shopId, attendanceDate])
  @@index([status])
  @@map("attendances")
}

model Penalty {
  id           String        @id @default(uuid())
  workerId     String
  worker       Worker        @relation(fields: [workerId], references: [id])
  attendanceId String        @unique
  attendance   Attendance    @relation(fields: [attendanceId], references: [id])
  amount       Int
  reason       String
  status       PenaltyStatus @default(PENDING)
  approvedBy   String?
  approver     User?         @relation("PenaltyApprovedBy", fields: [approvedBy], references: [id])
  approvedAt   DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status])
  @@index([workerId])
  @@map("penalties")
}

model Absence {
  id           String        @id @default(uuid())
  workerId     String
  worker       Worker        @relation(fields: [workerId], references: [id])
  shopId       String
  shop         Shop          @relation(fields: [shopId], references: [id])
  date         DateTime      @db.Date
  reason       String?
  status       AbsenceStatus @default(PENDING)
  validatedBy  String?
  validator    User?         @relation("AbsenceValidatedBy", fields: [validatedBy], references: [id])
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([workerId, date])
  @@index([shopId, date])
  @@index([status])
  @@map("absences")
}

// Règles de pénalité configurables (paliers). Remplace les valeurs codées en dur.
model PenaltyRule {
  id           String   @id @default(uuid())
  fromMinutes  Int
  toMinutes    Int? // null = illimité (ex: "> 60 minutes")
  amount       Int
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@map("penalty_rules")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // e.g. "WORKER_CREATED", "PENALTY_APPROVED"
  entity    String // e.g. "Worker", "Penalty"
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
