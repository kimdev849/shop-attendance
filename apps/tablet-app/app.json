{
  "expo": {
    "name": "StaffGo",
    "slug": "staffgo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "staffgo",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F2A43"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.staffgo.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Autoriser StaffGo à utiliser Face ID pour confirmer votre identité."
      }
    },
    "android": {
      "package": "com.staffgo.app",
      "permissions": ["USE_BIOMETRIC", "USE_FINGERPRINT"],
      "adaptiveIcon": {
        "backgroundColor": "#0F2A43"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Autoriser $(PRODUCT_NAME) à utiliser Face ID pour confirmer votre identité."
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      }
    }
  }
}
